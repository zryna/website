{
  "name": "@zryna/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "architecture:check": "node tools/architecture/check.mjs",
    "docs:check": "node tools/docs/check-bundle.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "node --test tests/**/*.test.mjs",
    "build": "pnpm architecture:check && astro check && astro build",
    "verify": "pnpm format:check && pnpm test && pnpm build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.10",
    "astro": "7.2.9",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "ajv": "8.20.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
