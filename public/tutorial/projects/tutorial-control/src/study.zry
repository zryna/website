export function sumTo(limit: i32): i32 {
  let next: i32 = 1;
  let total: i32 = 0;
  while (next <= limit) {
    total = total + next;
    next = next + 1;
  }
  return total;
}

export function addPerfectBonus(score: i32, perfect: bool): i32 {
  if (perfect) {
    return score + 5;
  }
  return score;
}
